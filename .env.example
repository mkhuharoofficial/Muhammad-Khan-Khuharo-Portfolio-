# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode for the Portfolio CMS Studio (defaults to "mk-admin-2026" in local dev if unset).
ADMIN_PASSCODE="CHANGE_THIS_PASSCODE"

# SESSION_SECRET: Secret used to sign admin session tokens on the server.
SESSION_SECRET="CHANGE_THIS_SESSION_SECRET"

# SMTP Email Configuration (Optional — if omitted, contact form submissions are still saved to the Admin Inbox)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="mkhuharoofficial@gmail.com"
SMTP_PASS="YOUR_APP_PASSWORD"
CONTACT_TO_EMAIL="mkhuharoofficial@gmail.com"
